# Local process configuration only. Copy to .env (ignored by Git).
# Real credentials belong in the ignored JSON files, never in this template.
JOBBOD_CONFIG_FILE=.secrets/backend_config.json
JOBBOD_MIGRATION_CONFIG_FILE=.secrets/migration_config.json
JOBBOD_REQUIRE_CONFIG=1
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
